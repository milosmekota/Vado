            {icon}
            <Typography variant="h6" sx={{ lineHeight: 1.2 }}>
              {title}
            </Typography>
          </Box>
          <Typography variant="body2" color="text.secondary">
            {subtitle}
          </Typography>
        </CardContent>
      </CardActionArea>
